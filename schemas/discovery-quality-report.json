{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiscoveryQualityReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rubric_version",
    "workspace_path",
    "evaluated_at",
    "gate",
    "overall_score",
    "summary",
    "dimensions",
    "metrics",
    "findings",
    "recommendations"
  ],
  "properties": {
    "rubric_version": { "type": "string" },
    "workspace_path": { "type": "string" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "gate": { "$ref": "#/$defs/gate" },
    "overall_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "summary": { "type": "string" },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dimension" }
    },
    "metrics": { "$ref": "#/$defs/metrics" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "recommendations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "gate": {
      "type": "string",
      "enum": ["pass", "warn", "fail"]
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "error"]
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "score", "gate", "summary"],
      "properties": {
        "name": { "type": "string" },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "gate": { "$ref": "#/$defs/gate" },
        "summary": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message", "related_paths", "related_ids"],
      "properties": {
        "severity": { "$ref": "#/$defs/severity" },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "related_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "related_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_item_count",
        "inference_count",
        "profile_key_concept_count",
        "specification_fact_count",
        "verification_fact_count",
        "structure_fact_count",
        "implementation_fact_count",
        "missing_provenance_count",
        "duplicate_display_item_count",
        "unsupported_profile_claim_count",
        "heuristic_layer_rule_count",
        "confidence_ten_policy_violations",
        "profile_faithfulness_mismatch_count",
        "stale_artifacts",
        "used_fallback_profile",
        "missing_artifact_count",
        "current_phase"
      ],
      "properties": {
        "evidence_item_count": { "type": "integer", "minimum": 0 },
        "inference_count": { "type": "integer", "minimum": 0 },
        "profile_key_concept_count": { "type": "integer", "minimum": 0 },
        "specification_fact_count": { "type": "integer", "minimum": 0 },
        "verification_fact_count": { "type": "integer", "minimum": 0 },
        "structure_fact_count": { "type": "integer", "minimum": 0 },
        "implementation_fact_count": { "type": "integer", "minimum": 0 },
        "missing_provenance_count": { "type": "integer", "minimum": 0 },
        "duplicate_display_item_count": { "type": "integer", "minimum": 0 },
        "unsupported_profile_claim_count": { "type": "integer", "minimum": 0 },
        "heuristic_layer_rule_count": { "type": "integer", "minimum": 0 },
        "confidence_ten_policy_violations": { "type": "integer", "minimum": 0 },
        "profile_faithfulness_mismatch_count": { "type": "integer", "minimum": 0 },
        "stale_artifacts": { "type": "boolean" },
        "used_fallback_profile": { "type": "boolean" },
        "missing_artifact_count": { "type": "integer", "minimum": 0 },
        "current_phase": { "type": "string" }
      }
    }
  }
}
