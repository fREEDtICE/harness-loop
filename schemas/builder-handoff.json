{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BuilderHandoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "changed_files", "verification", "open_questions"],
  "properties": {
    "summary": { "type": "string" },
    "changed_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verification": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
