{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspaceDiscoveryInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_path",
    "generated_at",
    "summary",
    "inferences",
    "risks"
  ],
  "properties": {
    "workspace_path": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "summary": { "type": "string" },
    "inferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/inference" }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "evidence_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "strength", "evidence_ids"],
      "properties": {
        "label": { "type": "string" },
        "strength": {
          "type": "string",
          "enum": ["weak", "moderate", "strong"]
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "statement",
        "confidence",
        "rationale",
        "evidence_chains",
        "assumptions",
        "contradictions"
      ],
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "statement": { "type": "string" },
        "confidence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "rationale": { "type": "string" },
        "evidence_chains": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_chain" }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "contradictions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
