{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoopSmith",
  "version": "0.1.0",
  "identifier": "io.loopsmith.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LoopSmith",
        "width": 1560,
        "height": 980,
        "minWidth": 1240,
        "minHeight": 780,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "LoopSmith – a long-running application development harness",
    "copyright": "© 2025 LoopSmith",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": null,
      "nsis": null
    }
  }
}
